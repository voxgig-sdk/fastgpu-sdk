# Entity: match

main: kit: entity: match: {

  alias: field: {}

  fields: {
    billed_hours: {
      h: "Billed Hours"
      n: "billed_hours"
      r: false
      sh: "Hours the provider bills for duration_hours: rounded up to whole hours on a per-hour meter and to whole minutes on a per-minute meter."
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    billing_increment: {
      h: "Billing Increment"
      n: "billing_increment"
      r: false
      sh: "How this provider's meter ticks for on-demand rental; varies means FastGPU has no verified figure."
      t: "`$STRING`"
    }
    effective_usd_hr: {
      h: "Effective Usd Hr"
      n: "effective_usd_hr"
      r: false
      t: "`$NUMBER`"
    }
    estimated_total_usd: {
      h: "Estimated Total Usd"
      n: "estimated_total_usd"
      r: false
      sh: "effective_usd_hr times billed_hours, rounded up to the cent."
      t: [
        "`$ONE`"
        [
          "`$NUMBER`"
          "`$NULL`"
        ]
      ]
    }
    fetched_at: {
      h: "Fetched At"
      n: "fetched_at"
      r: false
      sh: "When this price was fetched from the provider (ISO 8601)."
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
