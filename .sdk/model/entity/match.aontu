    }
    monthly_usd: {
      h: "Monthly Usd"
      n: "monthly_usd"
      r: false
      t: "`$NUMBER`"
    }
    offer_type: {
      h: "Offer Type"
      n: "offer_type"
      r: false
      t: "`$STRING`"
    }
    over_budget: {
      h: "Over Budget"
      n: "over_budget"
      r: false
      t: "`$BOOLEAN`"
    }
    page_url: {
      h: "Page Url"
      n: "page_url"
      r: false
      sh: "Absolute URL of this GPU's live price page, with every live offer."
      t: "`$STRING`"
    }
    partner: {
      h: "Partner"
      n: "partner"
      r: false
      t: "`$BOOLEAN`"
    }
    provider: {
      h: "Provider"
      n: "provider"
      r: false
      t: "`$STRING`"
    }
    provider_label: {
      h: "Provider Label"
      n: "provider_label"
      r: false
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    quote_age_seconds: {
      h: "Quote Age Seconds"
      n: "quote_age_seconds"
      r: false
      sh: "Seconds between fetched_at and as_of."
      t: [
        "`$ONE`"
        [
          "`$INTEGER`"
          "`$NULL`"
        ]
      ]
    }
    reason: {
      h: "Reason"
      n: "reason"
      r: false
      t: "`$STRING`"
    }
    reliability: {
      h: "Reliability"
      n: "reliability"
      r: false
      t: "`$STRING`"
